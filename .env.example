# Copy to .env and fill in. Loaded automatically by app.py.
ADMIN_USER=admin
ADMIN_PASSWORD=
# DB_PATH=hooks.db
# PUBLIC_URL=https://hooks.example.com
# REDMINE_URL=
# REDMINE_API_KEY=

# --- Push summaries -------------------------------------------------------
# The provider and model are chosen in the admin UI under Settings -> Push
# summaries. These only set the defaults and the limits.
# SUMMARY_COMMAND=claude          # path to the Claude Code CLI
# SUMMARY_MODEL=claude-sonnet-5   # default model for the Claude provider
# SUMMARY_TIMEOUT=120             # seconds to wait for the Claude CLI
# SUMMARY_MAX_COMMITS=50          # commits sent to the model per push
# OLLAMA_ENDPOINT=http://localhost:11434
# OLLAMA_TIMEOUT=300              # a big model can take minutes just to load

# --- @mention assistant ---------------------------------------------------
# Switched on, and projects mapped to code directories, under Assistant in
# the admin UI. It uses SUMMARY_COMMAND to find the Claude CLI.
# ASSISTANT_POLL_SECONDS=60       # how often Redmine is checked; 0 = never
# ASSISTANT_TIMEOUT=600           # seconds one code analysis may take
